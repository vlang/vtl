#!/usr/bin/env bash

## Copyright (C) 2019-2021 Ulises Jeremias Cornejo Fandos
## Licensed under MIT
##
##     @script.name [OPTION] ARGUMENTS...
##
## Options:
##     -h, --help                            Prints usage and example
##         --stats                           Execute with stats
##         --prod                            Execute with prod build
##         --use-cblas                       Execute tests using cblas
##         --use-lapacke                     Execute tests using lapacke
##         --use-autofree                    Execute tests using atofree
##         --use-gc=STRATEGY                 Execute tests using garbage collector
##         --full                            Full v test tree and all examples (high RAM)
##

ROOT=$(dirname "$0")

source "${ROOT}/util/easyoptions/easyoptions.sh" || exit
source "${ROOT}/util/logs.sh" || exit

set -eo pipefail

vtl_dir_path=$(dirname "$(dirname "$0")")

flags=()

if [[ -n "${use_cblas}" ]]; then
    echo "Running tests using Open BLAS"
    flags+=( -d cblas )
fi

if [[ -n "${use_lapacke}" ]]; then
    echo "Running tests using LAPACKE"
    flags+=( -d vsl_lapack_lapacke )
fi

if [[ -n "${use_autofree}" ]]; then
    echo "Running tests using V Math"
    flags+=( -autofree )
fi

if [[ -n "${use_gc}" ]]; then
    echo "Running tests using V Math"
    flags+=( -gc "${use_gc}" )
fi

if [[ -n "${stats}" ]]; then
    echo "Running tests with stats"
    flags+=( -stats )
fi

if [[ -n "${prod}" ]]; then
    echo "Running tests with prod"
    # Keep prod optimizations but avoid LTO, which overflows/corrupts objects on
    # GitHub runner toolchains.
    flags+=( -prod -no-prod-options -cflags -O3 -cflags -fno-lto )
fi

# Examples that OOM default GitHub runners at compile time (see docs/DEV_LIGHTWEIGHT.md).
should_skip_example() {
    case "$1" in
        */examples/nn_cifar10/main.v) return 0 ;;
        */examples/vtl_opencl_vcl_support/main.v) return 0 ;;
    esac
    return 1
}

export VJOBS="${VJOBS:-2}"

if [[ -n "${full}" ]]; then
    echo "Full CI mode (high RAM): v test entire tree"
    v "${flags[@]}" test "${vtl_dir_path}"
else
	echo "Scoped CI mode (VJOBS=${VJOBS}): discover all test packages and release compiler memory between packages"
	for file in "${vtl_dir_path}"/*_test.v; do
		if [[ -f "${file}" ]]; then
			echo "Testing ${file#"${vtl_dir_path}"/}"
			v "${flags[@]}" test "${file}"
	fi
	done
	test_dirs=()
	while IFS= read -r test_dir; do
		if [[ "${test_dir}" == "${vtl_dir_path}" ]]; then
			continue
		fi
		test_dirs+=("${test_dir}")
	done < <(find "${vtl_dir_path}" -type f -name '*_test.v' -exec dirname {} \; | sort -u)
	for test_dir in "${test_dirs[@]}"; do
		relative_dir=${test_dir#"${vtl_dir_path}"/}
		case "${relative_dir}" in
			nn|nn/models) continue ;;
		esac
		if [[ "${relative_dir}" == "nn/layers" || "${relative_dir}" == "tests/core" ]]; then
			echo "Testing ${relative_dir} one file at a time to cap compiler memory"
			for file in "${test_dir}"/*_test.v; do
				if [[ -f "${file}" ]]; then
					echo "Testing ${file#"${vtl_dir_path}"/}"
					v "${flags[@]}" test "${file}"
				fi
			done
			continue
		fi
		has_test_parent=false
		case "${relative_dir}" in
			nn/*) ;;
			*)
				for parent_dir in "${test_dirs[@]}"; do
					if [[ "${test_dir}" == "${parent_dir}/"* ]]; then
						has_test_parent=true
						break
					fi
				done
				;;
		esac
		if [[ "${has_test_parent}" == true ]]; then
			continue
		fi
		echo "Testing ${relative_dir}"
		v "${flags[@]}" test "${test_dir}"
	done
	echo "Testing nn root and nn/models one file at a time to cap compiler memory"
	for file in "${vtl_dir_path}"/nn/*_test.v "${vtl_dir_path}"/nn/models/*_test.v; do
		if [[ -f "${file}" ]]; then
			echo "Testing ${file#"${vtl_dir_path}"/}"
			v "${flags[@]}" test "${file}"
		fi
	done
fi

find "${vtl_dir_path}" -name '*_test' -exec rm -f {} + 2>/dev/null || true

if [[ -n "${prod}" ]]; then
    echo "Skipping example compilation in prod mode (covered by non-prod CI matrix)"
    exit 0
fi

echo "Compiling Examples with flags ${flags[*]}"
while IFS= read -r -d '' file; do
    if [[ "${file}" == *"not_ci"* ]]; then
        echo "Skipping ${file} (not_ci)"
        continue
    fi
    if should_skip_example "${file}"; then
        if [[ "${file}" == *"vtl_opencl_vcl_support/main.v" ]]; then
            echo "Skipping ${file} (requires -d vcl; run the OpenCL CI smoke step)"
        else
            echo "Skipping ${file} (heavy; use bin/test --full or label full-ml)"
        fi
        continue
    fi
    echo "Compiling ${file}"
    v "${flags[@]}" -o "${file}.bin" "${file}"
    rm -f "${file}.bin"
done < <(find "${vtl_dir_path}" -wholename '*/examples/*/main.v' -print0 | sort -z)

if [[ -z "${full}" ]]; then
    echo "Running nn_cifar10_tiny_synth smoke (f64)"
    v "${flags[@]}" run "${vtl_dir_path}/examples/nn_cifar10_tiny_synth/main.v"
    echo "Running nn_cifar10_f32_tiny_synth smoke (f32)"
    v "${flags[@]}" run "${vtl_dir_path}/examples/nn_cifar10_f32_tiny_synth/main.v"
fi
